<Project>
  <PropertyGroup>
    <!-- TODO fill in -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors></Authors>
    <Description></Description>
  </PropertyGroup>

  <!-- TODO update or remove as needed
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
