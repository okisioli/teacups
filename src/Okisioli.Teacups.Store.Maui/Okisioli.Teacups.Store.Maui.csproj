<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Limit only this project in platform CI; global TargetFrameworks overrides also retarget project references. -->
    <TargetFrameworks Condition="'$(TeacupsStoreTargetFramework)' != ''">$(TeacupsStoreTargetFramework)</TargetFrameworks>
    <NuGetLockFilePath Condition="'$(TeacupsStoreTargetFramework)' != ''">packages.$(TeacupsStoreTargetFramework).lock.json</NuGetLockFilePath>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <PackageId>Okisioli.Teacups.Store.Maui</PackageId>
    <Version>0.12.0</Version>
    <Description>.NET MAUI Essentials-backed secure key/value storage for Okisioli.Teacups.Store.</Description>
    <PackageReleaseNotes>Targeted native .NET 10 Android, iOS, Mac Catalyst, and Windows implementations using MAUI Essentials 10.</PackageReleaseNotes>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- This storage library has no PRI resources or Win2D calls; the consuming app owns native deployment. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Essentials" />
    <ProjectReference Include="..\Okisioli.Teacups.Store\Okisioli.Teacups.Store.csproj" />
  </ItemGroup>
</Project>
